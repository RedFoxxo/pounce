# Instance root, without any /api/... suffix.
TP_BASE_URL=https://mamami.tpondemand.com
# Personal access token. Never commit a real value.
TP_TOKEN=
# Optional: project used only when a call has no card or parent to inherit one from.
TP_DEFAULT_PROJECT_ID=
# Optional: team used for creations when none is given; omitted from payloads when unset.
TP_DEFAULT_TEAM_ID=
