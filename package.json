{
  "name": "@redfoxxo/pounce",
  "version": "1.0.1",
  "description": "MCP server for Targetprocess: read and manage cards by name, with your team rules enforced and every write verified",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "targetprocess",
    "apptio",
    "ai",
    "claude",
    "opencode"
  ],
  "author": "Foxxo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedFoxxo/pounce.git"
  },
  "homepage": "https://github.com/RedFoxxo/pounce#readme",
  "bugs": {
    "url": "https://github.com/RedFoxxo/pounce/issues"
  },
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "pounce": "build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "TP_LIVE=1 vitest run --config vitest.live.config.ts",
    "snapshot": "npm run build && node build/catalog/snapshot-cli.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
